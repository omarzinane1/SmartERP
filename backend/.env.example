DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DB_NAME=smarterp_ai
DB_USER=smarterp_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# Used by both Django producers and the Celery worker.
# Select config.settings.production through DJANGO_SETTINGS_MODULE in production.
CELERY_BROKER_URL=redis://localhost:6379/0

# Start a single Beat process only after enabling these optional schedules.
CELERY_BEAT_ENABLED=false

# Opt-in SMTP delivery. Tests always use locmem and never contact this server.
EMAIL_DELIVERY_ENABLED=false
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
