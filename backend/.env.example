DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-generated-local-secret
DB_NAME=smarterp_ai
DB_USER=smarterp_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

# Used by both Django producers and the Celery worker.
# Select config.settings.production through DJANGO_SETTINGS_MODULE in production.
CELERY_BROKER_URL=redis://localhost:6379/0

# Start a single Beat process only after enabling these optional schedules.
CELERY_BEAT_ENABLED=false

# Opt-in SMTP delivery. Tests always use locmem and never contact this server.
EMAIL_DELIVERY_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@smarterp.local

# Local AI, explicit configuration required in production; no automatic model pull.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_TIMEOUT=45
RAG_MAX_COSINE_DISTANCE=0.65
